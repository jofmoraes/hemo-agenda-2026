{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hemo://schemas/b3-gsh2-review-1.0",
  "type": "object",
  "required": ["kind", "schemaVersion", "status", "source", "coverage", "counts", "ids", "records", "diffAgainstApp1"],
  "properties": {
    "kind": { "const": "HEMO_B3_GSH2_REVIEW" },
    "schemaVersion": { "const": "1.0" },
    "status": { "const": "READY_FOR_ORCHESTRATOR_REVIEW" },
    "source": {
      "type": "object",
      "required": ["primaryFile", "primarySha256", "files"],
      "properties": {
        "primaryFile": { "type": "string" },
        "primarySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "files": { "type": "array", "minItems": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["inputRecords", "uniqueIds", "gshMentionIds", "namedSearch"],
      "properties": {
        "inputRecords": { "const": 1987 },
        "uniqueIds": { "const": 1987 },
        "gshMentionIds": { "type": "array", "items": { "type": "string" } },
        "namedSearch": { "type": "object" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["confirmedIds", "relatedTitleIds", "reviewOnlyIds", "falsePositiveIds", "futureFilterIds"],
      "properties": {
        "confirmedIds": { "const": 21 },
        "relatedTitleIds": { "const": 6 },
        "reviewOnlyIds": { "const": 5 },
        "falsePositiveIds": { "const": 1 },
        "futureFilterIds": { "const": 27 }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["officialId", "title", "authors", "status", "confidence", "evidence", "decision"],
        "properties": {
          "officialId": { "type": "string", "pattern": "^[0-9]+$" },
          "status": { "enum": ["AUTHOR_IDENTITY_CONFIRMED", "GSH_INSTITUTION_EVIDENCED", "GSH_TITLE_EVIDENCED_AUTHORSHIP_UNVERIFIED", "LEAD_NEEDS_EVIDENCE", "FALSE_POSITIVE"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidence": { "type": "array", "minItems": 1 },
          "decision": { "type": "string" }
        }
      }
    },
    "diffAgainstApp1": {
      "type": "object",
      "required": ["baseBranch", "baseSha", "added", "removed", "changed", "filterSetUnchanged"],
      "properties": {
        "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "added": { "type": "array", "maxItems": 0 },
        "removed": { "type": "array", "maxItems": 0 },
        "changed": { "type": "array" },
        "filterSetUnchanged": { "const": true }
      }
    }
  }
}
